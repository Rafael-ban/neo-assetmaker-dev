{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhodesepass.local/schemas/vs_job.schema.json",
  "title": "RenderJob",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "epoch",
    "track",
    "project_root",
    "source",
    "timeline",
    "transform",
    "output",
    "paths"
  ],
  "properties": {
    "api_version": {"type": "integer", "const": 1},
    "epoch": {"type": "integer", "minimum": 0},
    "track": {"enum": ["loop", "intro"]},
    "project_root": {"$ref": "#/$defs/absolutePath"},
    "source": {"$ref": "#/$defs/source"},
    "timeline": {"$ref": "#/$defs/timeline"},
    "transform": {"$ref": "#/$defs/transform"},
    "output": {"$ref": "#/$defs/output"},
    "paths": {"$ref": "#/$defs/paths"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {"kind": {"const": "image"}}
          }
        }
      },
      "then": {
        "properties": {
          "timeline": {
            "properties": {
              "end_frame": {"type": "integer", "minimum": 1},
              "fps": {"$ref": "#/$defs/fps"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[A-Za-z]:\\\\(?:[^\\\\/<>:\u0022|?*]+(?:\\\\[^\\\\/<>:\u0022|?*]+)*)?|\\\\\\\\[^\\\\/<>:\u0022|?*]+\\\\[^\\\\/<>:\u0022|?*]+(?:\\\\[^\\\\/<>:\u0022|?*]+)*)$",
      "allOf": [
        {
          "not": {"pattern": "(?:^|\\\\)\\.{1,2}(?:\\\\|$)"}
        },
        {
          "not": {"pattern": "[\\u0000-\\u001F]"}
        },
        {
          "not": {"pattern": "(?:^|\\\\)[^\\\\]*[ .](?:\\\\|$)"}
        }
      ]
    },
    "fps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 1},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "virtual_frame_count"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "kind": {"enum": ["video", "image"]},
        "virtual_frame_count": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {"const": "video"},
            "virtual_frame_count": {"type": "null"}
          }
        },
        {
          "properties": {
            "kind": {"const": "image"},
            "virtual_frame_count": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_frame", "end_frame", "fps"],
      "properties": {
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame": {"type": ["integer", "null"], "minimum": 1},
        "fps": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/fps"}
          ]
        }
      }
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate_space", "x", "y", "width", "height"],
      "properties": {
        "coordinate_space": {"const": "post_rotation_source_pixels"},
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 0},
        "height": {"type": "integer", "minimum": 0}
      },
      "oneOf": [
        {
          "properties": {
            "width": {"const": 0},
            "height": {"const": 0}
          }
        },
        {
          "properties": {
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rotation", "crop"],
      "properties": {
        "rotation": {"type": "integer", "enum": [0, 90, 180, 270]},
        "crop": {"$ref": "#/$defs/crop"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "display_width",
        "display_height",
        "coded_width",
        "coded_height",
        "pixel_format",
        "matrix",
        "transfer",
        "primaries",
        "range",
        "final_rotate_180"
      ],
      "properties": {
        "profile": {"enum": ["360x640", "720x1080"]},
        "display_width": {"type": "integer", "minimum": 1},
        "display_height": {"type": "integer", "minimum": 1},
        "coded_width": {"type": "integer", "minimum": 1},
        "coded_height": {"type": "integer", "minimum": 1},
        "pixel_format": {"const": "YUV420P8"},
        "matrix": {"type": "string", "minLength": 1},
        "transfer": {"type": "string", "minLength": 1},
        "primaries": {"type": "string", "minLength": 1},
        "range": {"enum": ["limited", "full"]},
        "final_rotate_180": {"type": "boolean"}
      },
      "oneOf": [
        {
          "properties": {
            "profile": {"const": "360x640"},
            "display_width": {"const": 360},
            "display_height": {"const": 640},
            "coded_width": {"const": 360},
            "coded_height": {"const": 640},
            "final_rotate_180": {"const": false}
          }
        },
        {
          "properties": {
            "profile": {"const": "720x1080"},
            "display_width": {"const": 720},
            "display_height": {"const": 1080},
            "coded_width": {"const": 720},
            "coded_height": {"const": 1080},
            "final_rotate_180": {"const": false}
          }
        }
      ]
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cache_dir"],
      "properties": {
        "cache_dir": {"$ref": "#/$defs/absolutePath"}
      }
    }
  }
}
